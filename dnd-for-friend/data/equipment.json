  "_source": "SRD 5.2.1 Equipment (CC-BY-4.0). Costs in GP; weight in lb.",
  "weaponProperties": {
    "Ammunition": "ต้องมีกระสุน (ลูกธนู/โบลต์) ยิงแล้วเก็บคืนได้ครึ่งหนึ่งหลังสู้",
    "Finesse": "เลือกใช้ STR หรือ DEX ก็ได้ทั้งตีและดาเมจ",
    "Heavy": "ถ้า STR (ระยะประชิด) หรือ DEX (ระยะไกล) ต่ำกว่า 13 ตีเสียเปรียบ",
    "Light": "ตีด้วยอาวุธ Light แล้ว ตีเพิ่มอีกครั้งด้วยอาวุธ Light อีกมือเป็น Bonus Action (ไม่บวกค่าสถานะในดาเมจ)",
    "Loading": "ยิงได้ 1 นัดต่อ Action/Bonus Action/Reaction",
    "Reach": "ระยะตีเพิ่ม 5 ฟุต (2 ช่อง)",
    "Thrown": "ขว้างได้ ใช้ค่าสถานะเดียวกับตอนตีประชิด",
    "Two-Handed": "ต้องใช้สองมือ",
    "Versatile": "ถือสองมือได้ดาเมจในวงเล็บ"
  },
  "masteries": {
    "Cleave": {"en": "On a melee hit, make one more attack vs a second creature within 5 ft of the first (no ability mod to damage). Once per turn.", "th": "ตีโดนแล้วฟันต่อศัตรูตัวที่สองที่ติดกันได้อีกครั้ง (เทิร์นละครั้ง)"},
    "Graze": {"en": "On a miss, deal damage equal to the ability modifier used for the attack.", "th": "ตีพลาดก็ยังทำดาเมจเท่าค่าสถานะที่ใช้ตี"},
    "Nick": {"en": "The Light extra attack can be part of the Attack action instead of a Bonus Action. Once per turn.", "th": "การตีเพิ่มของอาวุธ Light ไม่ต้องใช้ Bonus Action"},
    "Push": {"en": "On a hit, push a Large or smaller creature up to 10 ft straight away.", "th": "ตีโดนผลักศัตรูถอยไป 10 ฟุต (2 ช่อง)"},
    "Sap": {"en": "On a hit, the target has Disadvantage on its next attack roll before the start of your next turn.", "th": "ตีโดนแล้วศัตรูตีครั้งถัดไปเสียเปรียบ"},
    "Slow": {"en": "On a hit that deals damage, reduce the target's Speed by 10 ft until the start of your next turn.", "th": "ตีโดนลดความเร็วศัตรู 10 ฟุต"},
    "Topple": {"en": "On a hit, the target makes a CON save (DC 8 + ability mod + PB) or falls Prone.", "th": "ตีโดนให้ศัตรูเซฟ CON ไม่ผ่านล้มลง"},
    "Vex": {"en": "On a hit that deals damage, you have Advantage on your next attack roll vs that creature before the end of your next turn.", "th": "ตีโดนแล้วตีตัวเดิมครั้งถัดไปได้เปรียบ"}
  },
